<?xml version="1.0" encoding="utf-8"?>

<!-- The whole screen is a DrawerLayout: the normal screen plus a drawer that
     can slide in from the start (left) edge. The main screen MUST come first
     and the NavigationView last, so the drawer is drawn on top of it. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 1. The normal screen: App Bar + NavHost -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- The App Bar. Its title comes from each destination's android:label
             in nav_graph.xml. On a top-level screen it shows ☰ (open drawer);
             anywhere else it shows ← (up). -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/panel_blue"
            android:minHeight="?attr/actionBarSize" />

        <!-- The NavHost: the placeholder the Navigation Component swaps
             Fragments into. defaultNavHost="true" hands the phone's Back
             button to the NavController. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />

    </LinearLayout>

    <!-- 2. The drawer: a header (the signed-in user) plus a menu whose item IDs
         are the destination IDs in nav_graph.xml. -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
