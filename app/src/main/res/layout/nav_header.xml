<?xml version="1.0" encoding="utf-8"?>

<!-- The top of the navigation drawer: app name and the email that was carried
     from LoginActivity. gravity="bottom" pins both lines to the bottom of the
     header, which is where drawer headers usually put the user's details. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:background="@color/drawer_header_blue"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/headerTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tenant Management System"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/headerEmailTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="user@example.com"
        android:textColor="@color/white"
        android:textSize="14sp" />

</LinearLayout>
