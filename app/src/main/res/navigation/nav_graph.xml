<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <!-- The map of the app. Each <action> is a directed road from one
         destination to another; Safe Args turns every action into a function.
         Safe Args also needs the animations on the two Dashboard actions. -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.tenantmanagementsystemgroupa.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_addTenantFragment"
            app:destination="@id/addTenantFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />

        <action
            android:id="@+id/action_dashboardFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/addTenantFragment"
        android:name="com.example.tenantmanagementsystemgroupa.AddTenantFragment"
        android:label="Add Tenant"
        tools:layout="@layout/fragment_add_tenant">

        <!-- popUpTo="@id/dashboardFragment" removes the Add Tenant form (and
             anything else above the Dashboard) BEFORE going to View Tenants,
             so Back from View Tenants lands on the Dashboard, not on the form
             the user has just finished with. Without popUpToInclusive the
             Dashboard itself stays on the stack, so Back does not close the app. -->
        <action
            android:id="@+id/action_addTenantFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment"
            app:popUpTo="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/viewTenantsFragment"
        android:name="com.example.tenantmanagementsystemgroupa.ViewTenantsFragment"
        android:label="View Tenants"
        tools:layout="@layout/fragment_view_tenants">

        <!-- Safe Args: the tenant travels in this argument. It must be nullable
             with a default of @null, because the same screen is also opened
             from the Dashboard, the ⋮ menu and the drawer with no tenant.
             Without : Serializable on Tenant, this line would not build. -->
        <argument
            android:name="newTenant"
            android:defaultValue="@null"
            app:argType="com.example.tenantmanagementsystemgroupa.Tenant"
            app:nullable="true" />
    </fragment>

</navigation>
